# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=aurestate
POSTGRES_USER=aurestate_user
POSTGRES_PASSWORD=changeme_in_prod
DATABASE_URL=postgresql+asyncpg://aurestate_user:changeme_in_prod@db:5432/aurestate

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ── Sécurité / Auth ───────────────────────────────────────────────────────────
API_KEY_SECRET=changeme_in_prod
JWT_SECRET=changeme_in_prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── APIs externes ─────────────────────────────────────────────────────────────
API_ADRESSE_URL=https://api-adresse.data.gouv.fr
DVF_API_URL=https://apidf-preprod.cerema.fr
DPE_API_URL=https://data.ademe.fr/data-fair/api/v1/datasets

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
